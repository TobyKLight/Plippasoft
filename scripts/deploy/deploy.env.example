# Copy to ~/.config/plippa-deploy/deploy.env (NOT into the repo). No password here.
PI_HOST=192.168.0.235
PI_USER=plip
PI_DIR=/home/plip/projects/Plippasoft
# PROFILE=release          # must match ExecStart in the unit (the Pi's drop-in
#                          # /etc/systemd/system/plippa.service.d/profile.conf -> target/release/plippa;
#                          # the repo's base unit says target/debug/ and is overridden). Pushing the
#                          # other profile changes nothing that runs on the device.
